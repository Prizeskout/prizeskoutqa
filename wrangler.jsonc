{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "prizeskoutqa",

  // Entry point: @cloudflare/vite-plugin builds the SSR environment to
  // dist/server/index.js (MAIN_ENTRY_NAME = "index" in the plugin source).
  "main": "dist/server/index.js",

  // Static assets: Wrangler serves files from dist/client/ directly from
  // the CDN. Requests that don't match a static asset are forwarded to the
  // Worker above.
  "assets": {
    "directory": "dist/client"
  },

  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"]
}
