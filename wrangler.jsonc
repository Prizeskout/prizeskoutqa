{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "prizeskoutqa",

  // pages_build_output_dir is intentionally absent.
  // Cloudflare Pages' auto-deploy (triggered by that field) does not support
  // --bundle, so it would fail with:
  //   "_worker.js is not being bundled by Wrangler but it is importing
  //    from another file."
  // Instead, the build script calls `wrangler pages deploy --bundle` directly
  // (see the "build" script in package.json).

  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
}
