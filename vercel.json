{
  "version": 2,

  "outputDirectory": "dist/client",

  "functions": {
    "api/server.ts": {
      "includeFiles": "dist/server/**",
      "maxDuration": 30
    }
  },

  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/server"
    }
  ],

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
